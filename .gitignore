# Allowlist: only the public site is committed. The signing key lives in
# ~/.local/share/oyzmo-flatpak/ and must never land here.
/*
!/.gitignore
!/.nojekyll
!/CNAME
!/README.md
!/index.html
!/oyzmo.gpg
!/*.flatpakref
!/*.flatpakrepo
!/repo/
!/tools/
# ostree scratch space and lock, never part of the published repo
/repo/tmp/
/repo/.lock
# Never a private key, wherever it lands — not even inside repo/
*.asc
*.key
*.rev
*.kbx
private-keys-v1.d/
gnupg/
